<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- WebView takes prefers-color-scheme from this theme's isLightTheme; values-night is the dark one. -->
    <style name="Theme.Kestrel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kestrel_bg</item>
        <item name="android:statusBarColor">@color/kestrel_bg</item>
        <item name="android:navigationBarColor">@color/kestrel_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#fb923c</item>
    </style>

    <style name="Theme.Kestrel.Panic">
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
